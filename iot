#include <DHT.h>

#define DHTPIN 12
DHT dht(DHTPIN, DHT11);

void setup() {
  Serial.begin(9600);
  dht.begin();
}

void loop() {
  Serial.print("Temperature: ");
  Serial.print(dht.readTemperature());
  Serial.println(" C ");
  Serial.print("Humidity: ");
  Serial.println(dht.readHumidity());
  delay(1000);
}



