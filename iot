#define PH_PIN 34

void setup() {
  Serial.begin(115200);
}

void loop() {
  float v = analogRead(PH_PIN) * (3.3 / 4095.0);
  float pH = 7.0 + (1.65 - v) * 3.5;
  Serial.print("pH Value: ");
  Serial.println(pH);
  delay(2000);
}

